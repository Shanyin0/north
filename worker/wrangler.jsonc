{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "north",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // 备份存这儿。id 换成你自己那个 KV 的 ID
  "kv_namespaces": [
    { "binding": "BK", "id": "e01a4fe9c1e8449dbf3733e3960f290c" }
  ],

  // 模型站的地址。不是秘密，写在这儿，省得再去网页上填一个
  "vars": {
    "UPSTREAM": "https://api.gemai.cc"
  }

  // 剩下两个是真秘密，在网页上加，都要勾 Secret：
  //   Worker → Settings → Variables and Secrets（不是 Build 那一节）
  //     PASS          自己定的口令，手机上填一样的
  //     UPSTREAM_KEY  模型站那个 sk- 开头的 key
}
