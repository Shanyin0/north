{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "north",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // 整份备份存这儿。id 换成你自己那个 KV 的 ID
  "kv_namespaces": [
    { "binding": "BK", "id": "e01a4fe9c1e8449dbf3733e3960f290c" }
  ],

  // 聊天流水账存这儿。库名和 ID 是从 Cloudflare 的「Copy binding」直接抄的，
  // 不是我猜的 —— 上一回我瞎填了个占位的中文，把整个构建搞挂了。
  //
  // 库叫 north，不叫 mengxia（我 README 里那个名字写错了）。
  // 建表语句在 worker/README.md，已经在 D1 的 Console 里跑过一次了。
  //
  // 这个 Worker 从 Git 部署，bindings 以这个文件为准 ——
  // 在网页上 Settings → Bindings 里手动加的，下一次部署会被冲掉。
  "d1_databases": [
    { "binding": "DB", "database_name": "north", "database_id": "ad31e803-553c-47d5-a06a-4d6af1cc53a8" }
  ]

  // 三个都在网页上填，而且都要勾 Secret：
  //   Worker → Settings → Variables and Secrets（不是 Build 那一节）
  //     PASS          自己定的口令，手机上填一样的
  //     UPSTREAM      模型站的地址
  //     UPSTREAM_KEY  模型站那个 sk- 开头的 key
  //
  // 这儿一个 vars 都不写。写了的话：从 Git 部署会拿这份配置去覆盖网页上的普通
  // 变量，在网页上点 Deploy 又会盖回来，两边来回冲。Secret 谁都盖不掉，所以
  // 三个统一走 Secret，这个文件只管代码和 KV。
}
